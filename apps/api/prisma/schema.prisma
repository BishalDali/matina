generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  draft
  published
  archived
}

enum ImageType {
  front
  back
  closeup
  lifestyle
}

enum InventoryReason {
  opening_stock
  restock
  manual_adjustment
  order_placed
  order_cancelled
  delivery_failed
}

enum DiscountType {
  fixed
  percentage
}

enum BannerPlacement {
  hero
  category
  promotion
  collection
}

enum SectionType {
  announcement
  hero
  categories
  collections
  featured_products
  promo_banner
  brand_story
  instagram
}

enum PageType {
  story
  journal
  faq
  policy
  contact
}

enum OrderStatus {
  confirmed
  processing
  packed
  shipped
  delivered
  cancelled
  returned
}

enum ShippingRuleType {
  flat
  province
  district
}

enum AdminRole {
  super_admin
  manager
  order_staff
  content_staff
}

model Category {
  id             String     @id @default(cuid())
  parentId       String?    @map("parent_id")
  parent         Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[] @relation("CategoryHierarchy")
  name           String
  slug           String     @unique
  description    String?
  imageUrl       String?    @map("image_url")
  bannerUrl      String?    @map("banner_url")
  displayOrder   Int        @default(0) @map("display_order")
  isPublished    Boolean    @default(true) @map("is_published")
  seoTitle       String?    @map("seo_title")
  seoDescription String?    @map("seo_description")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  products Product[]

  @@index([isPublished, displayOrder])
  @@map("categories")
}

model Collection {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String?
  imageUrl       String?  @map("image_url")
  bannerUrl      String?  @map("banner_url")
  displayOrder   Int      @default(0) @map("display_order")
  isFeatured     Boolean  @default(false) @map("is_featured")
  isPublished    Boolean  @default(true) @map("is_published")
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  products ProductCollection[]

  @@index([isPublished, isFeatured, displayOrder])
  @@map("collections")
}

model Product {
  id               String        @id @default(cuid())
  categoryId       String        @map("category_id")
  category         Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name             String
  slug             String        @unique
  skuPrefix        String        @unique @map("sku_prefix")
  shortDescription String?       @map("short_description")
  fullDescription  String?       @map("full_description")
  fabricCare       String?       @map("fabric_care")
  sizeGuideJson    Json?         @map("size_guide_json")
  basePriceNpr     Int           @map("base_price_npr")
  status           ProductStatus @default(draft)
  isFeatured       Boolean       @default(false) @map("is_featured")
  badges           String[]      @default([])
  displayOrder     Int           @default(0) @map("display_order")
  salesCount       Int           @default(0) @map("sales_count")
  seoTitle         String?       @map("seo_title")
  seoDescription   String?       @map("seo_description")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  collections ProductCollection[]
  images      ProductImage[]
  variants    ProductVariant[]
  offers      ProductOffer[]
  wishlists   WishlistItem[]
  orderItems  OrderItem[]

  @@index([status, categoryId, displayOrder])
  @@index([status, isFeatured])
  @@map("products")
}

model ProductCollection {
  productId    String     @map("product_id")
  collectionId String     @map("collection_id")
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@map("product_collections")
}

model ProductImage {
  id           String    @id @default(cuid())
  productId    String    @map("product_id")
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  altText      String?   @map("alt_text")
  imageType    ImageType @default(front) @map("image_type")
  displayOrder Int       @default(0) @map("display_order")

  @@index([productId, displayOrder])
  @@map("product_images")
}

model ProductVariant {
  id               String  @id @default(cuid())
  productId        String  @map("product_id")
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  colourName       String  @map("colour_name")
  colourHex        String  @default("#1C1917") @map("colour_hex")
  size             String
  sku              String  @unique
  priceOverrideNpr Int?    @map("price_override_npr")
  isActive         Boolean @default(true) @map("is_active")

  inventory  Inventory?
  movements  InventoryMovement[]
  offers     ProductOffer[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, colourName, size])
  @@index([productId, isActive])
  @@map("product_variants")
}

model Inventory {
  variantId         String         @id @map("variant_id")
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  availableQty      Int            @default(0) @map("available_qty")
  lowStockThreshold Int            @default(5) @map("low_stock_threshold")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  @@map("inventory")
}

model InventoryMovement {
  id          String          @id @default(cuid())
  variantId   String          @map("variant_id")
  variant     ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  delta       Int
  reason      InventoryReason
  note        String?
  orderId     String?         @map("order_id")
  order       Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  adminUserId String?         @map("admin_user_id")
  adminUser   AdminUser?      @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([variantId, createdAt])
  @@map("inventory_movements")
}

model ProductOffer {
  id            String          @id @default(cuid())
  productId     String          @map("product_id")
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId     String?         @map("variant_id")
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  offerPriceNpr Int             @map("offer_price_npr")
  startsAt      DateTime        @default(now()) @map("starts_at")
  endsAt        DateTime?       @map("ends_at")
  isActive      Boolean         @default(true) @map("is_active")
  createdAt     DateTime        @default(now()) @map("created_at")

  @@index([productId, isActive, startsAt, endsAt])
  @@map("product_offers")
}

model Coupon {
  id                  String       @id @default(cuid())
  code                String       @unique
  discountType        DiscountType @map("discount_type")
  discountValue       Int          @map("discount_value")
  minOrderNpr         Int          @default(0) @map("min_order_npr")
  maxUses             Int?         @map("max_uses")
  usedCount           Int          @default(0) @map("used_count")
  perCustomerLimit    Int?         @map("per_customer_limit")
  combinableWithOffer Boolean      @default(false) @map("combinable_with_offer")
  startsAt            DateTime     @default(now()) @map("starts_at")
  endsAt              DateTime?    @map("ends_at")
  isActive            Boolean      @default(true) @map("is_active")
  createdAt           DateTime     @default(now()) @map("created_at")

  @@map("coupons")
}

model Banner {
  id              String          @id @default(cuid())
  placement       BannerPlacement @default(hero)
  placementRefId  String?         @map("placement_ref_id")
  desktopImageUrl String          @map("desktop_image_url")
  mobileImageUrl  String?         @map("mobile_image_url")
  heading         String?
  subheading      String?
  ctaText         String?         @map("cta_text")
  ctaLink         String?         @map("cta_link")
  displayOrder    Int             @default(0) @map("display_order")
  startsAt        DateTime        @default(now()) @map("starts_at")
  endsAt          DateTime?       @map("ends_at")
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([placement, isActive, displayOrder])
  @@map("banners")
}

model HomepageSection {
  id           String      @id @default(cuid())
  sectionType  SectionType @map("section_type")
  title        String
  subtitle     String?
  configJson   Json        @default("{}") @map("config_json")
  displayOrder Int         @default(0) @map("display_order")
  isVisible    Boolean     @default(true) @map("is_visible")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([isVisible, displayOrder])
  @@map("homepage_sections")
}

model InstagramPost {
  id           String   @id @default(cuid())
  mediaUrl     String   @map("media_url")
  permalink    String
  caption      String?
  source       String   @default("manual")
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("instagram_posts")
}

model ContentPage {
  id             String    @id @default(cuid())
  pageType       PageType  @map("page_type")
  title          String
  slug           String    @unique
  excerpt        String?
  contentJson    Json      @default("{}") @map("content_json")
  coverImageUrl  String?   @map("cover_image_url")
  seoTitle       String?   @map("seo_title")
  seoDescription String?   @map("seo_description")
  isPublished    Boolean   @default(true) @map("is_published")
  publishedAt    DateTime? @map("published_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("content_pages")
}

model SiteSetting {
  key       String   @id
  valueJson Json     @map("value_json")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model Customer {
  id                 String   @id @default(cuid())
  fullName           String   @map("full_name")
  phone              String   @unique
  email              String?
  passwordHash       String?  @map("password_hash")
  savedAddressesJson Json     @default("[]") @map("saved_addresses_json")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  orders   Order[]
  carts    Cart[]
  wishlist WishlistItem[]

  @@map("customers")
}

model Cart {
  id           String     @id @default(cuid())
  sessionToken String     @unique @map("session_token")
  customerId   String?    @map("customer_id")
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items        CartItem[]
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("carts")
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String         @map("cart_id")
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String         @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model WishlistItem {
  id           String    @id @default(cuid())
  sessionToken String    @map("session_token")
  customerId   String?   @map("customer_id")
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId    String    @map("product_id")
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now()) @map("created_at")

  @@unique([sessionToken, productId])
  @@map("wishlist_items")
}

model ShippingRule {
  id                       String           @id @default(cuid())
  name                     String
  ruleType                 ShippingRuleType @default(flat) @map("rule_type")
  province                 String?
  district                 String?
  feeNpr                   Int              @map("fee_npr")
  freeShippingThresholdNpr Int?             @map("free_shipping_threshold_npr")
  isActive                 Boolean          @default(true) @map("is_active")

  @@map("shipping_rules")
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique @map("order_number")
  customerId     String?     @map("customer_id")
  customer       Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName   String      @map("customer_name")
  phone          String
  email          String?
  province       String
  district       String
  municipality   String
  wardNo         String      @map("ward_no")
  streetTole     String      @map("street_tole")
  deliveryNotes  String?     @map("delivery_notes")
  subtotalNpr    Int         @map("subtotal_npr")
  discountNpr    Int         @default(0) @map("discount_npr")
  couponCode     String?     @map("coupon_code")
  deliveryFeeNpr Int         @map("delivery_fee_npr")
  totalNpr       Int         @map("total_npr")
  paymentMethod  String      @default("COD") @map("payment_method")
  status         OrderStatus @default(confirmed)
  idempotencyKey String      @unique @map("idempotency_key")
  internalNotes  String?     @map("internal_notes")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  items     OrderItem[]
  history   OrderStatusHistory[]
  movements InventoryMovement[]

  @@index([orderNumber, phone])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id                   String          @id @default(cuid())
  orderId              String          @map("order_id")
  order                Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId            String?         @map("product_id")
  product              Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId            String?         @map("variant_id")
  variant              ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productNameSnapshot  String          @map("product_name_snapshot")
  colourSnapshot       String          @map("colour_snapshot")
  sizeSnapshot         String          @map("size_snapshot")
  skuSnapshot          String          @map("sku_snapshot")
  regularPriceSnapshot Int             @map("regular_price_snapshot")
  unitPriceSnapshot    Int             @map("unit_price_snapshot")
  quantity             Int
  lineTotalNpr         Int             @map("line_total_npr")

  @@map("order_items")
}

model OrderStatusHistory {
  id               String      @id @default(cuid())
  orderId          String      @map("order_id")
  order            Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status           OrderStatus
  note             String?
  changedByAdminId String?     @map("changed_by_admin_id")
  changedByAdmin   AdminUser?  @relation(fields: [changedByAdminId], references: [id], onDelete: SetNull)
  createdAt        DateTime    @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model AdminUser {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  passwordHash String   @map("password_hash")
  role        AdminRole @default(manager)
  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  statusChanges      OrderStatusHistory[]
  inventoryMovements InventoryMovement[]

  @@map("admin_users")
}

model CustomWearTemplate {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  garmentType  String   @map("garment_type") // tshirt | sweatshirt | hoodie
  description  String?
  basePriceNpr Int      @map("base_price_npr")
  availableSizes String[] @default(["S", "M", "L", "XL", "XXL"]) @map("available_sizes")
  availableColors Json  @default("[]") @map("available_colors")
  isActive     Boolean  @default(true) @map("is_active")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  requests CustomOrderRequest[]

  @@map("custom_wear_templates")
}

model CustomOrderRequest {
  id              String             @id @default(cuid())
  requestNumber   String             @unique @map("request_number")
  templateId      String             @map("template_id")
  template        CustomWearTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  garmentType     String             @map("garment_type")
  colourName      String             @map("colour_name")
  colourHex       String             @map("colour_hex")
  size            String
  quantity        Int                @default(1)
  placement       String             @default("front") // front | back
  designImageUrl  String?            @map("design_image_url")
  customText      String?            @map("custom_text")
  designConfig    Json               @default("{}") @map("design_config") // { x, y, scale, rotation, textColor }
  customerName    String             @map("customer_name")
  phone           String
  email           String?
  deliveryAddress String             @map("delivery_address")
  notes           String?
  estimatedPriceNpr Int              @map("estimated_price_npr")
  status          String             @default("pending_review") // pending_review | approved | in_production | shipped | delivered | cancelled
  internalNotes   String?            @map("internal_notes")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("custom_order_requests")
}
